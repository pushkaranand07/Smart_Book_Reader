# Base URL of the Smart Book Reader API, prepended to every request and to signed image URLs.
# Leave empty to call the same origin (Vite dev/preview proxy locally, nginx in Docker).
# Example for a separately hosted API (Vercel frontend + Railway API): https://api.example.com
VITE_API_URL=

# Port of the local API that the Vite dev/preview proxy forwards /api, /healthz and /readyz to.
VITE_API_PORT=8000

# Optional: full proxy target, overrides VITE_API_PORT (used by the real-API e2e run).
# VITE_API_PROXY_TARGET=http://127.0.0.1:8000

# End-to-end tests (Playwright). Mocked by default; set E2E_REAL_API=1 to hit a real backend.
# E2E_REAL_API=1
# E2E_API_URL=http://127.0.0.1:8000
# E2E_API_KEY=dev-key
# E2E_PDF=../tests/fixtures/sample.pdf
# E2E_QUESTION=What is this book about?

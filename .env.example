# Copy to .env and fill in. Every variable is optional unless marked REQUIRED.

# ---- server
ENVIRONMENT=production
PORT=8000
DATA_DIR=./data
LOG_LEVEL=INFO
LOG_JSON=true

# ---- auth (REQUIRED for AUTH_MODE=api_key): comma-separated owner:key pairs
AUTH_MODE=api_key
API_KEYS=alice:change-me-to-a-long-random-key
# AUTH_MODE=jwt uses HS256 tokens with "sub" and "exp" claims
JWT_SECRET=
JWT_AUDIENCE=

# REQUIRED in production: signs short-lived figure/PDF URLs (generate: python -c "import secrets;print(secrets.token_urlsafe(32))")
MEDIA_SIGNING_SECRET=
MEDIA_URL_TTL_SECONDS=3600

# ---- limits
MAX_UPLOAD_MB=50
MAX_PAGES=1500
RATE_LIMIT_UPLOAD=10/minute
RATE_LIMIT_ASK=60/minute
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---- background jobs: process (low-priority worker started by the API, default) | huey (separate worker service) | thread | immediate (tests)
JOBS_MODE=process
BOOK_CACHE_SIZE=8

# ---- models
WARM_MODELS_ON_START=true
QA_BACKEND=transformers
OCR_ENGINE=rapidocr
# Florence: disabled | base (Florence-2-base, no adapter) | required (/readyz fails without fine-tuned weights)
FLORENCE_MODE=disabled
# Private Hugging Face repo holding the fine-tuned adapter (adapter_model.safetensors + adapter_config.json)
FLORENCE_HF_REPO=
FLORENCE_HF_REVISION=
HF_TOKEN=

# ---- optional LLM synthesis (the app works fully offline without it; Azure wins if both are set)
# Azure OpenAI: the deployment name is the name you gave the deployment, not the model name.
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT_NAME=
OPENAI_API_VERSION=2025-04-01-preview
# Reasoning models (gpt-5, o-series): minimal | low | medium | high. Lower is faster and cheaper.
AZURE_OPENAI_REASONING_EFFORT=low
# Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
